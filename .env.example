# WX Open Chat (root) env example
# Copy to .env if you want local shell defaults for scripts.

# Optional: installer fallback vault path
# Used by: ./scripts/install-to-obsidian.sh
OBSIDIAN_VAULT_PATH=/path/to/your/Obsidian/Vault

# Optional convenience values (plugin uses its own settings UI)
WX_BRIDGE_URL=http://127.0.0.1:8787/v1/chat
WX_BRIDGE_TOKEN=wx_your_bridge_token_here

# Note:
# Bridge runtime env vars live in: bridge/.env.example
