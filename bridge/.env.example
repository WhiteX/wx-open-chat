# Bridge listen port
PORT=8787

# Bearer token expected from plugin requests
# Keep this secret. Do not commit your real value.
BRIDGE_TOKEN=change-me

# Optional strict route pinning for safety
# If set, requests with different route data are rejected.
ALLOWED_TARGET_TYPE=topic
ALLOWED_GROUP_ID=-1003818622136
ALLOWED_TOPIC_ID=16

# Modes (choose one active mode)
# - ECHO_MODE=true: return echo reply for testing
# - LOCAL_ADAPTER_MODE=true: call local openclaw CLI
# - Otherwise: forward to UPSTREAM_URL
ECHO_MODE=false
LOCAL_ADAPTER_MODE=true

# Local adapter settings
OPENCLAW_BIN=openclaw
OPENCLAW_THINKING=low

# Route -> session mapping (choose either defaults or map)
# Defaults:
# For standalone mode, this is used when route.type=main
OPENCLAW_STANDALONE_SESSION=wx-open-chat-main
OPENCLAW_SESSION_MAIN=
OPENCLAW_SESSION_GROUP_DEFAULT=
OPENCLAW_SESSION_TOPIC_DEFAULT=

# Preferred: private route map file path (gitignored)
# JSON keys:
# - main
# - group:<groupId>
# - topic:<groupId>:<topicId>
# example: {"main":"abc","topic:-1003818622136:16":"session_xyz"}
OPENCLAW_ROUTE_MAP_JSON=.local/route-map.json

# Optional inline JSON map (less safe than file)
OPENCLAW_ROUTE_MAP=

# Generic upstream mode
UPSTREAM_URL=
UPSTREAM_TOKEN=

# Logging privacy: true masks group/topic/session ids in logs
REDACT_LOGS=true
